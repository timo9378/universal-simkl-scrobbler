# Copy to `.env` before building. Values are inlined at build time by dotenv-webpack.

# Optional, and normally left empty.
#
# The client id belongs in the extension's own options page now, not in the build —
# each install authorises against its own Simkl app, so nobody's requests are attributed
# to anybody else's id. Published releases are built with this unset.
#
# Setting it only skips having to paste the id after every fresh install, which is
# convenient while developing. A value here is a *fallback*: whatever is in the options
# page always wins. See StorageValuesOptionsV4.simklClientId.
#
# There is no client secret on purpose: the PIN flow doesn't use one, and a secret
# bundled into an extension isn't secret. See src/apis/SimklAuth.ts.
SIMKL_CLIENT_ID=

# Optional. Only used to fall back to TMDB artwork for the rare item Simkl has no
# poster or still for; leave it empty and those items simply show no image.
TMDB_API_KEY=

# Optional error reporting.
ROLLBAR_TOKEN=

# Only needed when publishing to the stores.
CHROME_EXTENSION_ID=
CHROME_EXTENSION_KEY=
FIREFOX_EXTENSION_ID=
